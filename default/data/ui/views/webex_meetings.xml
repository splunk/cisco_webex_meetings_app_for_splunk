<form version="1.1" theme="dark" stylesheet="style.css">
  <label>Webex Scheduled Meetings Overview</label>
  <fieldset submitButton="false">
    <input type="time" token="time">
      <label></label>
      <default>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
      </default>
    </input>
  </fieldset>
  <row>
    <panel>
      <single>
        <title>Number of Active Scheduled Meetings</title>
        <search>
          <query>`webex_meeting` sourcetype="cisco:webex:meetings"
| stats dc(id) as "Scheduled Meetings"</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
        <option name="drilldown">all</option>
        <option name="rangeColors">["0x53a051","0x0877a6","0xf8be34","0xf1813f","0xdc4e41"]</option>
        <option name="refresh.display">progressbar</option>
        <option name="underLabel">Number of Scheduled Meetings</option>
        <drilldown>
          <link target="_blank">/app/cisco_webex_meetings_app_for_splunk/webex_meetings</link>
        </drilldown>
      </single>
      <chart>
        <search>
          <query>`webex_meeting` sourcetype="cisco:webex:meetings"
| timechart span=1h dc(id) as "Scheduled Meetings"</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
        <option name="charting.axisTitleX.visibility">collapsed</option>
        <option name="charting.chart">column</option>
        <option name="charting.drilldown">none</option>
        <option name="charting.fieldColors">{"Scheduled Meetings": 0x3bbbdd}</option>
        <option name="charting.legend.placement">top</option>
        <option name="refresh.display">progressbar</option>
      </chart>
    </panel>
  </row>
</form>